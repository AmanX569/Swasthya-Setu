{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.bat",
      "**/*.cmd",
      "**/*.exe",
      "**/*.ps1",
      "**/*.sh",
      "**/*.log",
      ".git/**",
      ".github/**",
      "scratch/**",
      "bundle.js",
      "server.js",
      "package.json",
      "package-lock.json",
      "firestore.rules",
      "database.rules.json"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  }
}