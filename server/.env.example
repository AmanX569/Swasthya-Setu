# =========================================================
# SWASTHYA SETU — ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================

# Environment Mode: development | sandbox | production
NODE_ENV=development

# HTTP Port
PORT=5000

# Supabase PostgreSQL Configuration
SUPABASE_URL=https://bqtinztvktsosuypuifi.supabase.co
SUPABASE_ANON_KEY=sb_publishable_TLWSYjSbIrgVfbt86PjgOQ_TaOyTtz4
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters
JWT_EXPIRES_IN=24h

# SMS / OTP Provider: msg91 | sandbox | mock | twilio
# In production, set OTP_PROVIDER=msg91
OTP_PROVIDER=msg91
SMS_PROVIDER=msg91

# MSG91 V5 SendOTP Gateway Configuration
# Obtain Auth Key from MSG91 Dashboard -> Authkey
MSG91_AUTH_KEY=your_msg91_auth_key_here

# MSG91 OTP Template ID (Configured with approved DLT Template in MSG91)
MSG91_OTP_TEMPLATE_ID=your_msg91_otp_template_id_here

# DLT Approved Sender ID / Header (e.g. SWASTH, GOVIND)
MSG91_SENDER_ID=SWASTH

# DLT Registered Template ID (Principal Entity DLT Template ID)
MSG91_DLT_TEMPLATE_ID=

# MSG91 API Base URL (Default: https://control.msg91.com)
MSG91_BASE_URL=https://control.msg91.com

# Twilio SMS Credentials (only if SMS_PROVIDER=twilio)
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM_NUMBER=

# Ayushman Bharat Digital Mission (ABDM / ABHA)
ABDM_ENVIRONMENT=sandbox
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_BASE_URL=https://dev.abdm.gov.in/gateway/v0.5

# UIDAI / Aadhaar Authentication (Authorized AUA/KUA only)
UIDAI_ENVIRONMENT=sandbox
UIDAI_AUA_CODE=
UIDAI_SUB_AUA_CODE=
