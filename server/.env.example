# =========================================================
# SWASTHYA SETU — ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================

# Environment Mode: development | sandbox | production
NODE_ENV=development

# HTTP Port
PORT=5000

# Supabase PostgreSQL Configuration
SUPABASE_URL=https://bqtinztvktsosuypuifi.supabase.co
SUPABASE_ANON_KEY=sb_publishable_TLWSYjSbIrgVfbt86PjgOQ_TaOyTtz4
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters
JWT_EXPIRES_IN=24h

# SMS / OTP Provider: twilio | msg91 | sandbox | mock
# To use Twilio (Recommended - free trial, instant setup, no DLT required):
# Set OTP_PROVIDER=twilio
OTP_PROVIDER=twilio
SMS_PROVIDER=twilio

# ---------------------------------------------------------
# Twilio Configuration (Active when OTP_PROVIDER=twilio)
# Obtain from Twilio Console: https://console.twilio.com
# ---------------------------------------------------------
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Option A: Twilio Messages API (Direct SMS via Twilio phone number)
# Format: +1XXXXXXXXXX or +91XXXXXXXXXX
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Option B: Twilio Verify Service (Optional managed verification service)
# Format: VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_VERIFY_SERVICE_SID=

# Legacy Twilio variable aliases (supported for backwards compatibility):
# SMS_TWILIO_ACCOUNT_SID=
# SMS_TWILIO_AUTH_TOKEN=
# SMS_TWILIO_FROM_NUMBER=

# ---------------------------------------------------------
# MSG91 V5 Gateway Configuration (Only if OTP_PROVIDER=msg91)
# Note: Requires Indian DLT Registration, Entity ID, and Template Approval
# ---------------------------------------------------------
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER_ID=SWASTH
MSG91_DLT_TEMPLATE_ID=
MSG91_BASE_URL=https://control.msg91.com

# Ayushman Bharat Digital Mission (ABDM / ABHA)
ABDM_ENVIRONMENT=sandbox
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_BASE_URL=https://dev.abdm.gov.in/gateway/v0.5

# UIDAI / Aadhaar Authentication (Authorized AUA/KUA only)
UIDAI_ENVIRONMENT=sandbox
UIDAI_AUA_CODE=
UIDAI_SUB_AUA_CODE=
